+/** "web=~/Archive/web,docs=/srv/docs" -> { web: "/home/me/Archive/web", docs: "/srv/docs" }. */
+export function parseSaveRoots(spec: string): Record<string, string> {
+  const roots: Record<string, string> = {};
+  for (const part of spec.split(",").map((p) => p.trim()).filter(Boolean)) {
+    const eq = part.indexOf("=");
+    if (eq < 1) throw new Error(`CHROMERS_SAVE_ROOTS: "${part}" should be name=folder`);
+    const folder = part.slice(eq + 1).trim().replace(/^~(?=$|\/)/, homedir());
+    roots[part.slice(0, eq).trim()] = folder;
+  }
+  return roots;
+}
