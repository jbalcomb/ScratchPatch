diff --git a/daemon/src/saves.ts b/daemon/src/saves.ts
new file mode 100644
index 0000000..e66cb2b
--- /dev/null
+++ b/daemon/src/saves.ts
@@ -0,0 +1,161 @@
+import { appendFileSync, mkdirSync, realpathSync, writeFileSync, existsSync } from "node:fs";
+import { homedir } from "node:os";
+import { isAbsolute, join, relative, resolve, sep } from "node:path";
+import { randomBytes } from "node:crypto";
+import type { BrowserLink } from "./browser.js";
+import { CommandError } from "./browser.js";
+import type { Config } from "./config.js";
+
+/**
+ * Saving pages to this machine's disk, queued: callers (e.g. TaskDeck on a phone) queue a URL and
+ * come back for the result, so the save finishes even if they disconnect. One save at a time, in a
+ * background tab (the tab you're looking at is left alone), as MHTML (one file that Chrome/Edge open
+ * exactly as the page looked) and/or PDF.
+ */
+
+export type Format = "mhtml" | "pdf";
+
+export interface SaveJob {
+  id: string;
+  url: string;
+  root: string;
+  folder: string; // inside the root
+  formats: Format[];
+  name?: string; // file name without extension; default: page title + date
+  status: "queued" | "running" | "done" | "failed";
+  title?: string;
+  finalUrl?: string;
+  files: { path: string; bytes: number }[];
+  error?: string;
+  queuedAt: string;
+  finishedAt?: string;
+}
+
+const LOG = join(homedir(), ".config", "chromers", "saves.jsonl");
+const KEEP = 200; // finished jobs remembered for save.status / save.list
+const LOAD_TIMEOUT_MS = 60_000;
+const SETTLE_MS = 1500; // after the network goes quiet: late images, fonts, lazy content
+
+/** The folder for a save: inside the named root, never outside it (no "..", no absolute paths). */
+export function resolveFolder(roots: Record<string, string>, root: string, folder: string): string {
+  const base = roots[root];
+  if (!base) throw new CommandError(`unknown root "${root}"; allowed: ${Object.keys(roots).join(", ") || "none"}`);
+  const sub = (folder ?? "").trim().replace(/\\/g, "/");
+  if (isAbsolute(sub) || sub.split("/").includes("..")) throw new CommandError("folder must stay inside the root");
+  mkdirSync(base, { recursive: true });
+  const realBase = realpathSync(base);
+  const target = resolve(realBase, sub);
+  const rel = relative(realBase, target);
+  if (rel.startsWith("..") || isAbsolute(rel)) throw new CommandError("folder must stay inside the root");
+  mkdirSync(target, { recursive: true });
+  const realTarget = realpathSync(target); // a symlink inside the root must not lead out of it
+  if (realTarget !== realBase && !realTarget.startsWith(realBase + sep)) {
+    throw new CommandError("folder must stay inside the root");
+  }
+  return realTarget;
+}
+
+/** "My Page: Title?" -> "My Page - Title" (safe on Windows, Linux and macOS). */
+export function safeName(text: string, max = 80): string {
+  const s = text.replace(/[\\/:*?"<>|\x00-\x1f]+/g, " - ").replace(/\s+/g, " ").replace(/^[ .-]+|[ .-]+$/g, "");
+  return (s || "page").slice(0, max).trim();
+}
+
+function uniquePath(dir: string, base: string, ext: string): string {
+  let path = join(dir, `${base}.${ext}`);
+  for (let n = 2; existsSync(path); n++) path = join(dir, `${base} (${n}).${ext}`);
+  return path;
+}
+
+export class SaveQueue {
+  private jobs = new Map<string, SaveJob>();
+  private order: string[] = [];
+  private running = false;
+
+  constructor(private browser: BrowserLink, private config: Config, private logFile = LOG) {}
+
+  queue(req: { url: string; root: string; folder?: string; formats: Format[]; name?: string }): SaveJob {
+    resolveFolder(this.config.saveRoots, req.root, req.folder ?? ""); // refuse a bad folder now, not later
+    const job: SaveJob = {
+      id: randomBytes(6).toString("hex"),
+      url: req.url,
+      root: req.root,
+      folder: req.folder ?? "",
+      formats: req.formats,
+      name: req.name,
+      status: "queued",
+      files: [],
+      queuedAt: new Date().toISOString(),
+    };
+    this.jobs.set(job.id, job);
+    this.order.push(job.id);
+    while (this.order.length > KEEP) this.jobs.delete(this.order.shift()!);
+    void this.pump();
+    return job;
+  }
+
+  get(id: string): SaveJob {
+    const job = this.jobs.get(id);
+    if (!job) throw new CommandError(`no save job ${id} (finished jobs are remembered until the daemon restarts)`);
+    return job;
+  }
+
+  list(limit = 20): SaveJob[] {
+    return this.order.slice(-limit).reverse().map((id) => this.jobs.get(id)!).filter(Boolean);
+  }
+
+  private async pump(): Promise<void> {
+    if (this.running) return;
+    this.running = true;
+    try {
+      for (let job; (job = this.order.map((id) => this.jobs.get(id)!).find((j) => j?.status === "queued")); ) {
+        await this.run(job);
+      }
+    } finally {
+      this.running = false;
+    }
+  }
+
+  private async run(job: SaveJob): Promise<void> {
+    job.status = "running";
+    let page;
+    try {
+      const dir = resolveFolder(this.config.saveRoots, job.root, job.folder);
+      const browser = await this.browser.get();
+      page = await browser.newPage({ background: true });
+      await page.goto(job.url, { waitUntil: "networkidle2", timeout: LOAD_TIMEOUT_MS });
+      await new Promise((r) => setTimeout(r, SETTLE_MS));
+      job.title = await page.title();
+      job.finalUrl = page.url();
+      const stamp = new Date().toISOString().slice(0, 10);
+      const base = safeName(job.name || `${job.title || new URL(job.finalUrl).hostname} ${stamp}`);
+      if (job.formats.includes("mhtml")) {
+        const cdp = await page.createCDPSession();
+        const { data } = (await cdp.send("Page.captureSnapshot", { format: "mhtml" })) as { data: string };
+        await cdp.detach();
+        const path = uniquePath(dir, base, "mhtml");
+        writeFileSync(path, data);
+        job.files.push({ path, bytes: Buffer.byteLength(data) });
+      }
+      if (job.formats.includes("pdf")) {
+        const pdf = await page.pdf({ printBackground: true, format: "A4" });
+        const path = uniquePath(dir, base, "pdf");
+        writeFileSync(path, pdf);
+        job.files.push({ path, bytes: pdf.length });
+      }
+      job.status = "done";
+    } catch (e) {
+      job.status = "failed";
+      job.error = e instanceof Error ? e.message : String(e);
+    } finally {
+      job.finishedAt = new Date().toISOString();
+      await page?.close().catch(() => undefined);
+      try {
+        mkdirSync(join(this.logFile, ".."), { recursive: true });
+        appendFileSync(this.logFile, JSON.stringify(job) + "\n");
+      } catch {
+        // the log is a record, not required
+      }
+    }
+  }
+}
