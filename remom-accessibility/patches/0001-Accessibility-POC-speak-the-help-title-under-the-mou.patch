diff --git a/platform/include/Platform_Speech.h b/platform/include/Platform_Speech.h
new file mode 100644
index 0000000..23fee6d
--- /dev/null
+++ b/platform/include/Platform_Speech.h
@@ -0,0 +1,55 @@
+/**
+ * Platform_Speech.h — Text-to-speech output for accessibility (screen reader / OS voice).
+ *
+ * The engine decides WHAT to say (see MoX/src/Access.c); this layer decides HOW it is spoken.
+ * No SDL or Win32 types appear here.  One shared implementation (platform/speech/PFL_Speech.c)
+ * is linked into every backend:
+ *
+ *   Windows        Tolk.dll, loaded at runtime if present: speaks through the running screen reader
+ *                  (NVDA, JAWS, ...), falling back to SAPI when none is running.  No build dependency.
+ *   Linux          spd-say (Speech Dispatcher), which is what Orca uses.
+ *   macOS          say
+ *   headless       no audio; utterances are only logged/recorded, so tests can assert on them.
+ *
+ * Every utterance is also kept as "last spoken" and, when REMOM_SPEECH_LOG is set, written to stderr.
+ *
+ * See doc/@AI_Plans/PRD-Accessibility.md.
+ */
+
+#ifndef PLATFORM_SPEECH_H
+#define PLATFORM_SPEECH_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Load the speech backend.  Safe to call more than once; the first call does the work.
+ * Platform_Speak() calls this itself, so calling it explicitly only moves the load cost earlier.
+ */
+void Platform_Speech_Startup(void);
+
+/** Release the speech backend.  Safe to call when Platform_Speech_Startup() never ran. */
+void Platform_Speech_Shutdown(void);
+
+/**
+ * Speak text.  When interrupt is non-zero, anything still being spoken is cut off first,
+ * which is what you want for "the thing under the cursor changed".
+ * Text is the game's own 8-bit (code page 437) text.  NULL or empty is ignored.
+ */
+void Platform_Speak(const char * text, int interrupt);
+
+/** Stop speaking immediately. */
+void Platform_Speech_Stop(void);
+
+/** The most recent text passed to Platform_Speak() ("" if none).  For tests and diagnostics. */
+const char * Platform_Speech_Last(void);
+
+/** How many times Platform_Speak() has spoken (ignored NULL/empty calls are not counted).  For tests. */
+int Platform_Speech_Count(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  /* PLATFORM_SPEECH_H */
diff --git a/platform/speech/PFL_Speech.c b/platform/speech/PFL_Speech.c
new file mode 100644
index 0000000..9f9b2c6
--- /dev/null
+++ b/platform/speech/PFL_Speech.c
@@ -0,0 +1,359 @@
+/**
+ * PFL_Speech.c — Text-to-speech output for accessibility.  See Platform_Speech.h.
+ *
+ * Backend-agnostic: linked into every windowed backend and into Platform_Headless.  Platform_Headless is
+ * compiled with PFL_SPEECH_LOG_ONLY, so it never makes a sound and never starts a process; it only records
+ * the last utterance (and logs it when REMOM_SPEECH_LOG is set).
+ *
+ * Proof-of-concept scope: one engine (Tolk / spd-say / say), no voice or rate settings, no queueing beyond
+ * what the OS speech service does itself.
+ */
+
+#include "Platform_Speech.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if !defined(PFL_SPEECH_LOG_ONLY)
+#if defined(_WIN32)
+#include <windows.h>
+#else
+#include <errno.h>
+#include <signal.h>
+#include <spawn.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+extern char ** environ;
+#endif
+#endif
+
+
+
+#define SPEECH_TEXT_MAX  1024
+
+static int speech_started = 0;
+static int speech_log_enabled = 0;
+static int speech_count = 0;
+static char speech_last[SPEECH_TEXT_MAX] = "";
+
+
+
+/* ========================================================================= */
+/*  Windows: Tolk.dll (https://github.com/dkager/tolk), loaded at runtime     */
+/* ========================================================================= */
+
+#if !defined(PFL_SPEECH_LOG_ONLY) && defined(_WIN32)
+
+/* Tolk's exported C API.  Tolk uses C++ bool, which is ABI-compatible with C's unsigned char/_Bool return
+   on x64 (the only architecture ReMoM ships for Windows). */
+typedef void          (__cdecl * tolk_load_fn)(void);
+typedef void          (__cdecl * tolk_unload_fn)(void);
+typedef void          (__cdecl * tolk_try_sapi_fn)(unsigned char try_sapi);
+typedef unsigned char (__cdecl * tolk_output_fn)(const wchar_t * str, unsigned char interrupt);
+typedef unsigned char (__cdecl * tolk_silence_fn)(void);
+typedef const wchar_t * (__cdecl * tolk_detect_fn)(void);
+
+static HMODULE tolk_dll = NULL;
+static tolk_unload_fn tolk_unload = NULL;
+static tolk_output_fn tolk_output = NULL;
+static tolk_silence_fn tolk_silence = NULL;
+
+static void Speech_Backend_Startup(void)
+{
+    tolk_load_fn tolk_load = NULL;
+    tolk_try_sapi_fn tolk_try_sapi = NULL;
+    tolk_detect_fn tolk_detect = NULL;
+    const wchar_t * screen_reader = NULL;
+
+    tolk_dll = LoadLibraryA("Tolk.dll");
+    if(tolk_dll == NULL)
+    {
+        fprintf(stderr, "[speech] Tolk.dll not found next to ReMoM.exe; speech disabled (logging only).\n");
+        return;
+    }
+
+    tolk_load     = (tolk_load_fn)    GetProcAddress(tolk_dll, "Tolk_Load");
+    tolk_unload   = (tolk_unload_fn)  GetProcAddress(tolk_dll, "Tolk_Unload");
+    tolk_try_sapi = (tolk_try_sapi_fn)GetProcAddress(tolk_dll, "Tolk_TrySAPI");
+    tolk_output   = (tolk_output_fn)  GetProcAddress(tolk_dll, "Tolk_Output");
+    tolk_silence  = (tolk_silence_fn) GetProcAddress(tolk_dll, "Tolk_Silence");
+    tolk_detect   = (tolk_detect_fn)  GetProcAddress(tolk_dll, "Tolk_DetectScreenReader");
+
+    if((tolk_load == NULL) || (tolk_unload == NULL) || (tolk_output == NULL))
+    {
+        fprintf(stderr, "[speech] Tolk.dll is missing expected exports; speech disabled (logging only).\n");
+        FreeLibrary(tolk_dll);
+        tolk_dll = NULL;
+        tolk_output = NULL;
+        return;
+    }
+
+    /* Must come before Tolk_Load(): fall back to the Windows built-in voice when no screen reader runs. */
+    if(tolk_try_sapi != NULL)
+    {
+        tolk_try_sapi(1);
+    }
+
+    tolk_load();
+
+    if(tolk_detect != NULL)
+    {
+        screen_reader = tolk_detect();
+    }
+    fprintf(stderr, "[speech] Tolk loaded; screen reader: %ls\n", (screen_reader != NULL) ? screen_reader : L"(none, using SAPI)");
+}
+
+static void Speech_Backend_Shutdown(void)
+{
+    if(tolk_dll != NULL)
+    {
+        tolk_unload();
+        FreeLibrary(tolk_dll);
+        tolk_dll = NULL;
+        tolk_output = NULL;
+        tolk_silence = NULL;
+    }
+}
+
+static void Speech_Backend_Speak(const char * text, int interrupt)
+{
+    wchar_t wide_text[SPEECH_TEXT_MAX];
+
+    if(tolk_output == NULL)
+    {
+        return;
+    }
+
+    /* Game text is code page 437 (the DOS original); convert so accented and box characters survive. */
+    if(MultiByteToWideChar(437, 0, text, -1, wide_text, SPEECH_TEXT_MAX) == 0)
+    {
+        return;
+    }
+    wide_text[SPEECH_TEXT_MAX - 1] = L'\0';
+
+    tolk_output(wide_text, (unsigned char)(interrupt != 0));
+}
+
+static void Speech_Backend_Stop(void)
+{
+    if(tolk_silence != NULL)
+    {
+        tolk_silence();
+    }
+}
+
+
+
+/* ========================================================================= */
+/*  Linux / macOS: spawn the OS speech command                               */
+/* ========================================================================= */
+
+#elif !defined(PFL_SPEECH_LOG_ONLY)
+
+#if defined(__APPLE__)
+#define SPEECH_COMMAND  "say"
+#else
+#define SPEECH_COMMAND  "spd-say"
+#endif
+
+#define SPEECH_MAX_CHILDREN  32
+
+static int speech_available = 0;
+static pid_t speech_children[SPEECH_MAX_CHILDREN];
+static int speech_child_count = 0;
+static pid_t speech_last_child = 0;
+
+/* Reap finished speech processes so they do not linger as zombies. Only our own pids are waited on. */
+static void Speech_Reap_Children(void)
+{
+    int itr = 0;
+
+    while(itr < speech_child_count)
+    {
+        if(waitpid(speech_children[itr], NULL, WNOHANG) != 0)
+        {
+            speech_children[itr] = speech_children[speech_child_count - 1];
+            speech_child_count--;
+        }
+        else
+        {
+            itr++;
+        }
+    }
+}
+
+static pid_t Speech_Spawn(char * const argv[])
+{
+    pid_t pid = 0;
+    int result = 0;
+
+    Speech_Reap_Children();
+
+    if(speech_child_count >= SPEECH_MAX_CHILDREN)
+    {
+        return 0;  /* speech service is not keeping up; drop rather than pile up processes */
+    }
+
+    result = posix_spawnp(&pid, argv[0], NULL, NULL, argv, environ);
+    if(result != 0)
+    {
+        fprintf(stderr, "[speech] could not run '%s' (%s); speech disabled (logging only).\n", argv[0], strerror(result));
+        speech_available = 0;
+        return 0;
+    }
+
+    speech_children[speech_child_count] = pid;
+    speech_child_count++;
+
+    return pid;
+}
+
+static void Speech_Backend_Startup(void)
+{
+    speech_available = 1;
+    fprintf(stderr, "[speech] using '%s'\n", SPEECH_COMMAND);
+}
+
+static void Speech_Backend_Stop(void)
+{
+#if defined(__APPLE__)
+    if(speech_last_child > 0)
+    {
+        kill(speech_last_child, SIGTERM);
+        speech_last_child = 0;
+    }
+#else
+    char * cancel_argv[] = { "spd-say", "-C", NULL };
+    pid_t pid = 0;
+
+    if(speech_available == 0)
+    {
+        return;
+    }
+
+    /* Wait for the cancel to be delivered, so it cannot overtake the next utterance. */
+    pid = Speech_Spawn(cancel_argv);
+    if(pid > 0)
+    {
+        waitpid(pid, NULL, 0);
+        Speech_Reap_Children();
+    }
+#endif
+}
+
+static void Speech_Backend_Shutdown(void)
+{
+    Speech_Backend_Stop();
+}
+
+static void Speech_Backend_Speak(const char * text, int interrupt)
+{
+    char * speak_argv[] = { SPEECH_COMMAND, "--", (char *)text, NULL };
+
+    if(speech_available == 0)
+    {
+        return;
+    }
+
+    if(interrupt != 0)
+    {
+        Speech_Backend_Stop();
+        if(speech_available == 0)
+        {
+            return;  /* the cancel could not run, so neither will the speak */
+        }
+    }
+
+    /* Text goes in as one argv element, never through a shell, so game text cannot be interpreted as a command. */
+    speech_last_child = Speech_Spawn(speak_argv);
+}
+
+
+
+/* ========================================================================= */
+/*  Headless: log only                                                       */
+/* ========================================================================= */
+
+#else
+
+static void Speech_Backend_Startup(void) { }
+static void Speech_Backend_Shutdown(void) { }
+static void Speech_Backend_Speak(const char * text, int interrupt) { (void)text; (void)interrupt; }
+static void Speech_Backend_Stop(void) { }
+
+#endif
+
+
+
+/* ========================================================================= */
+/*  Public API                                                               */
+/* ========================================================================= */
+
+void Platform_Speech_Startup(void)
+{
+    const char * log_env = NULL;
+
+    if(speech_started != 0)
+    {
+        return;
+    }
+    speech_started = 1;
+
+    log_env = getenv("REMOM_SPEECH_LOG");
+    speech_log_enabled = ((log_env != NULL) && (log_env[0] != '\0') && (log_env[0] != '0'));
+
+    Speech_Backend_Startup();
+}
+
+void Platform_Speech_Shutdown(void)
+{
+    if(speech_started == 0)
+    {
+        return;
+    }
+
+    Speech_Backend_Shutdown();
+    speech_started = 0;
+}
+
+void Platform_Speak(const char * text, int interrupt)
+{
+    if((text == NULL) || (text[0] == '\0'))
+    {
+        return;
+    }
+
+    Platform_Speech_Startup();
+
+    strncpy(speech_last, text, (SPEECH_TEXT_MAX - 1));
+    speech_last[SPEECH_TEXT_MAX - 1] = '\0';
+    speech_count++;
+
+    if(speech_log_enabled != 0)
+    {
+        fprintf(stderr, "[speech] %s\"%s\"\n", (interrupt != 0) ? "" : "(queued) ", speech_last);
+    }
+
+    Speech_Backend_Speak(speech_last, interrupt);
+}
+
+void Platform_Speech_Stop(void)
+{
+    if(speech_started == 0)
+    {
+        return;
+    }
+
+    Speech_Backend_Stop();
+}
+
+const char * Platform_Speech_Last(void)
+{
+    return speech_last;
+}
+
+int Platform_Speech_Count(void)
+{
+    return speech_count;
+}
