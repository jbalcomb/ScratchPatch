new file mode 100644
index 0000000..1206281
--- /dev/null
+++ b/MoX/src/Access.c
@@ -0,0 +1,262 @@
+/*
+    CLAUDE: Accessibility layer -- NOT part of the original game.  See Access.h and doc/@AI_Plans/PRD-Accessibility.md.
+
+    Proof of concept: "hover to hear".  Every screen in the original registers a help list (Set_Help_List()) of
+    rectangles, each pointing at a HELP.LBX record; right-clicking inside one opens that record's help scroll.
+    Here, when the pointer moves into a different rectangle, the record's title is spoken.
+
+    HELP.LBX is read here with plain stdio, not LBX_Load_Data_Static(): that loader shares a cached file handle and
+    header buffer with the rest of the game and calls Error_Handler() (fatal) on any problem.  Reading our own copy
+    keeps this code from disturbing game state and lets a missing/odd file just mean "no speech".
+*/
+
+#include "Access.h"
+
+#include "../../platform/include/Platform_Speech.h"
+#include "../../STU/src/STU_GRAF.h"
+
+#include "Input.h"
+#include "MOX_BASE.h"
+#include "Mouse.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+
+
+#define ACCESS_HELP_LBX_ENTRY      2     /* HELP.LBX entry holding the struct s_HELP_DATA records */
+#define ACCESS_HELP_TITLE_LEN     30     /* sizeof(s_HELP_DATA.title) */
+#define ACCESS_LBX_MAGIC      0xFEAD
+
+static int16_t access_enabled = ST_FALSE;
+static int16_t access_last_help_idx = ST_UNDEFINED;
+
+static char (* access_help_titles)[ACCESS_HELP_TITLE_LEN + 1] = NULL;
+static int16_t access_help_title_count = 0;
+static int16_t access_help_titles_tried = ST_FALSE;
+
+
+
+static int Access_Read_U16(FILE * file, long offset, uint16_t * value)
+{
+    uint8_t bytes[2];
+
+    if((fseek(file, offset, SEEK_SET) != 0) || (fread(bytes, 1, 2, file) != 2))
+    {
+        return 0;
+    }
+    *value = (uint16_t)(bytes[0] | (bytes[1] << 8));
+    return 1;
+}
+
+static int Access_Read_U32(FILE * file, long offset, uint32_t * value)
+{
+    uint8_t bytes[4];
+
+    if((fseek(file, offset, SEEK_SET) != 0) || (fread(bytes, 1, 4, file) != 4))
+    {
+        return 0;
+    }
+    *value = ((uint32_t)bytes[0]) | ((uint32_t)bytes[1] << 8) | ((uint32_t)bytes[2] << 16) | ((uint32_t)bytes[3] << 24);
+    return 1;
+}
+
+
+int16_t Access_Load_Help_Titles(FILE * lbx_file)
+{
+    uint16_t num_entries = 0;
+    uint16_t magic = 0;
+    uint32_t entry_start = 0;
+    uint16_t num_records = 0;
+    uint16_t record_size = 0;
+    uint16_t itr = 0;
+    int16_t len = 0;
+
+    free(access_help_titles);
+    access_help_titles = NULL;
+    access_help_title_count = 0;
+
+    if(lbx_file == NULL)
+    {
+        return 0;
+    }
+
+    /* LBX header: u16 entry count, u16 magic 0xFEAD, u16, u16, then u32 entry offsets from byte 8. */
+    if(
+        !Access_Read_U16(lbx_file, 0, &num_entries) ||
+        !Access_Read_U16(lbx_file, 2, &magic) ||
+        (magic != ACCESS_LBX_MAGIC) ||
+        (num_entries <= ACCESS_HELP_LBX_ENTRY) ||
+        !Access_Read_U32(lbx_file, (8 + (ACCESS_HELP_LBX_ENTRY * 4)), &entry_start) ||
+        /* Record entry: u16 record count, u16 record size, then the records. */
+        !Access_Read_U16(lbx_file, (long)entry_start, &num_records) ||
+        !Access_Read_U16(lbx_file, (long)(entry_start + 2), &record_size) ||
+        (record_size < ACCESS_HELP_TITLE_LEN) ||
+        (num_records == 0) ||
+        (num_records > 0x7FFF)
+    )
+    {
+        fprintf(stderr, "[access] HELP.LBX: unexpected layout; hover speech disabled.\n");
+        return 0;
+    }
+
+    access_help_titles = calloc(num_records, sizeof(*access_help_titles));
+    if(access_help_titles == NULL)
+    {
+        return 0;
+    }
+
+    for(itr = 0; itr < num_records; itr++)
+    {
+        if(
+            (fseek(lbx_file, (long)(entry_start + 4 + ((uint32_t)itr * record_size)), SEEK_SET) != 0) ||
+            (fread(access_help_titles[itr], 1, ACCESS_HELP_TITLE_LEN, lbx_file) != ACCESS_HELP_TITLE_LEN)
+        )
+        {
+            break;
+        }
+        access_help_titles[itr][ACCESS_HELP_TITLE_LEN] = '\0';
+
+        /* Titles are NUL-terminated inside a fixed 30-byte field; drop trailing blanks too. */
+        len = (int16_t)strlen(access_help_titles[itr]);
+        while((len > 0) && (access_help_titles[itr][len - 1] == ' '))
+        {
+            len--;
+            access_help_titles[itr][len] = '\0';
+        }
+    }
+
+    access_help_title_count = (int16_t)itr;
+
+    return access_help_title_count;
+}
+
+
+const char * Access_Help_Title(int16_t help_idx)
+{
+    FILE * lbx_file = NULL;
+
+    if((access_help_titles == NULL) && (access_help_titles_tried == ST_FALSE))
+    {
+        access_help_titles_tried = ST_TRUE;
+        lbx_file = STU_GRAF_Open_Asset("HELP.LBX", "rb");
+        if(lbx_file == NULL)
+        {
+            fprintf(stderr, "[access] HELP.LBX not found; hover speech disabled.\n");
+        }
+        else
+        {
+            Access_Load_Help_Titles(lbx_file);
+            fclose(lbx_file);
+        }
+    }
+
+    if((help_idx < 0) || (help_idx >= access_help_title_count))
+    {
+        return "";
+    }
+
+    return access_help_titles[help_idx];
+}
+
+
+int16_t Access_Help_Index_At(int16_t x, int16_t y)
+{
+    int16_t i = 0;
+    int16_t j = 0;
+
+    if((help_list_active == ST_FALSE) || (help_list_count <= 0) || (help_struct_pointer == NULL))
+    {
+        return ST_UNDEFINED;
+    }
+
+    /* Same record layout and hit test as Check_Help_List(): [idx, x1, y1, x2, y2], first match wins. */
+    for(i = 0; i < help_list_count; i++)
+    {
+        j = (i * 5);
+
+        if(
+            (help_struct_pointer[j + 0] != ST_UNDEFINED)
+            &&
+            (help_struct_pointer[j + 1] <= x)
+            &&
+            (help_struct_pointer[j + 3] >= x)
+            &&
+            (help_struct_pointer[j + 2] <= y)
+            &&
+            (help_struct_pointer[j + 4] >= y)
+        )
+        {
+            return help_struct_pointer[j + 0];
+        }
+    }
+
+    return ST_UNDEFINED;
+}
+
+
+void Access_Update_At(int16_t x, int16_t y)
+{
+    int16_t help_idx = 0;
+    const char * title = NULL;
+
+    if(access_enabled == ST_FALSE)
+    {
+        return;
+    }
+
+    help_idx = Access_Help_Index_At(x, y);
+
+    if(help_idx == access_last_help_idx)
+    {
+        return;
+    }
+    access_last_help_idx = help_idx;
+
+    if(help_idx == ST_UNDEFINED)
+    {
+        return;
+    }
+
+    title = Access_Help_Title(help_idx);
+    if(title[0] != '\0')
+    {
+        Platform_Speak(title, ST_TRUE);
+    }
+}
+
+
+void Access_Frame(void)
+{
+    Access_Update_At(Pointer_X(), Pointer_Y());
+}
+
+
+void Access_Startup(int16_t enable)
+{
+    access_enabled = (enable != ST_FALSE) ? ST_TRUE : ST_FALSE;
+    access_last_help_idx = ST_UNDEFINED;
+
+    if(access_enabled == ST_TRUE)
+    {
+        Platform_Speech_Startup();
+        Platform_Speak("Master of Magic. Speech on.", ST_TRUE);
+    }
+}
+
+
+int16_t Access_Enabled(void)
+{
+    return access_enabled;
+}
+
+
+void Access_Reset(void)
+{
+    free(access_help_titles);
+    access_help_titles = NULL;
+    access_help_title_count = 0;
+    access_help_titles_tried = ST_FALSE;
+    access_last_help_idx = ST_UNDEFINED;
+    access_enabled = ST_FALSE;
+}
diff --git a/MoX/src/Access.h b/MoX/src/Access.h
new file mode 100644
index 0000000..0973582
--- /dev/null
+++ b/MoX/src/Access.h
@@ -0,0 +1,50 @@
+/*
+    CLAUDE: Accessibility layer -- NOT part of the original game.
+
+    The engine side of accessibility: decides WHAT to tell the player.  HOW it is spoken lives in the platform
+    layer (platform/include/Platform_Speech.h).  Nothing here changes original behaviour; it only reads engine
+    state, and does nothing at all unless enabled (--access or REMOM_ACCESS=1).
+
+    Proof of concept: when the mouse moves onto a different right-click-help area, speak that area's help title
+    from HELP.LBX.  See doc/@AI_Plans/PRD-Accessibility.md.
+*/
+
+#ifndef ACCESS_H
+#define ACCESS_H
+
+#include <stdint.h>
+#include <stdio.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Turn accessibility on or off.  Turning it on announces it, so a blind player knows speech works. */
+void Access_Startup(int16_t enable);
+
+int16_t Access_Enabled(void);
+
+/* Per-frame hook (Platform_Register_Frame_Callback).  Cheap: only speaks when the hovered help area changes. */
+void Access_Frame(void);
+
+/* Access_Frame() with explicit pointer coordinates (game space, 320x200).  Exposed for tests. */
+void Access_Update_At(int16_t x, int16_t y);
+
+/* HELP.LBX record index of the active help area containing (x, y), or ST_UNDEFINED.  Same hit test as Check_Help_List(). */
+int16_t Access_Help_Index_At(int16_t x, int16_t y);
+
+/* Title of a HELP.LBX record, trimmed; "" when unknown.  Loads HELP.LBX on first use. */
+const char * Access_Help_Title(int16_t help_idx);
+
+/* Read every record title from an open HELP.LBX (entry 2).  Returns the number of titles loaded, 0 on failure.
+   Replaces any titles already loaded.  Exposed so tests can feed a synthetic LBX. */
+int16_t Access_Load_Help_Titles(FILE * lbx_file);
+
+/* Drop loaded titles and reset state.  Exposed for tests. */
+void Access_Reset(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  /* ACCESS_H */
